{
    "configurations": [
        {
            "type": "java",
            "name": "Start Blood Inventory Web App",
            "request": "launch",
            "cwd": "${workspaceFolder}/bloodinventory",
            "mainClass": "com.fyp.bloodinventory.BloodinventoryApplication",
            "projectName": "bloodinventory",
            "args": "",
            "envFile": "${workspaceFolder}/bloodinventory/.env",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Tomcat started on port ([0-9]+)",
                "uriFormat": "http://localhost:%s/login"
            }
        }
    ]
}
